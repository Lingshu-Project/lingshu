{
  "name": "lingshu-markdown",
  "productName": "灵书 Markdown",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "灵书 Markdown 桌面编辑器 / Lingshu Markdown editor",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/prepare-export-assets.cjs && npm run typecheck && vite build --logLevel warn",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/documents.test.cjs tests/export.test.mjs tests/feedback.test.cjs",
    "verify:desktop": "node scripts/verify-desktop.cjs",
    "verify:language": "node scripts/verify-language.cjs",
    "package:portable": "node scripts/package-portable.cjs",
    "package:installer": "node scripts/package-installer.cjs"
  },
  "dependencies": {
    "@codemirror/language-data": "6.5.2",
    "@mdit/plugin-katex": "1.1.3",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-mark": "4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
